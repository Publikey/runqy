      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((asynq_tasks_enqueued_total{state=\"pending\",queue=~\"$queue\"} > 0) and on(queue) (runqy_queue_workers == 0) and on(queue) (asynq_queue_paused_total == 0)) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
